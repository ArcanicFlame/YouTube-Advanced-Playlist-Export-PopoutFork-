{
  "manifest_version": 3,
  "name": "YouTube Advanced Playlist Export",
  "version": "1.1.0",
  "description": "Export detailed information from YouTube playlists and watch panels in JSON, CSV, or TXT formats.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Advanced Playlist Export"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
